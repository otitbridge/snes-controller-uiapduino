 static volatile uint8_t mouse_report[4]    = {0, 0, 0, 0};
-static volatile uint8_t keyboard_report[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+/* Project patch: one main-loop writer, USB ISR reader on the same hart.
+ * Fill the inactive slot while the ISR can still read the published slot.
+ * Main cannot run during usb_send_data(), so that slot remains stable.
+ */
+static volatile uint8_t keyboard_report[2][8] = {{0}, {0}};
+static volatile uint8_t keyboard_active = 0;
 
 #ifdef UIAP_WEBHID
 // ============================================================
@@ -130,7 +135,9 @@
         mouse_report[3] = 0;
     } else if (endp == 2) {
         /* キーボード: ホストが解放を確認するまで同じ状態を保持 */
-        usb_send_data((uint8_t *)keyboard_report, 8, 0, sendtok);
+        const uint8_t active = keyboard_active;
+        __asm__ __volatile__("" ::: "memory");
+        usb_send_data((uint8_t *)keyboard_report[active], 8, 0, sendtok);
 #ifdef UIAP_WEBHID
     } else if (endp == 3) {
         /* WebHID TX: 新データがあれば送信、なければ NAK */
@@ -247,19 +254,23 @@
                            uint8_t k0, uint8_t k1, uint8_t k2,
                            uint8_t k3, uint8_t k4, uint8_t k5)
 {
-    keyboard_report[0] = modifier;
-    keyboard_report[1] = 0; /* reserved */
-    keyboard_report[2] = k0;
-    keyboard_report[3] = k1;
-    keyboard_report[4] = k2;
-    keyboard_report[5] = k3;
-    keyboard_report[6] = k4;
-    keyboard_report[7] = k5;
+    const uint8_t next = keyboard_active ^ 1u;
+    keyboard_report[next][0] = modifier;
+    keyboard_report[next][1] = 0; /* reserved */
+    keyboard_report[next][2] = k0;
+    keyboard_report[next][3] = k1;
+    keyboard_report[next][4] = k2;
+    keyboard_report[next][5] = k3;
+    keyboard_report[next][6] = k4;
+    keyboard_report[next][7] = k5;
+    /* Publish only after all eight stores; no interrupt masking. */
+    __asm__ __volatile__("" ::: "memory");
+    keyboard_active = next;
 }
 
