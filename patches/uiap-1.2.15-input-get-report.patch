+#ifndef UIAP_WEBHID
+/* Project patch: GET_REPORT(Input) for the pure KBD+Mouse configuration.
+ * SETUP and control IN are separate interrupts. Preserve a snapshot in EP0
+ * storage: main may publish twice and reuse either keyboard slot between them.
+ * The setup callback itself runs in the USB ISR, so main cannot change the
+ * published keyboard slot during this copy.
+ */
+void usb_handle_hid_get_report_start(struct usb_endpoint *e, int reqLen,
+                                      uint32_t lValueLSBIndexMSB)
+{
+#if UIAP_SNES_USB_TRACE
+    trace_note_control(0x01a1, lValueLSBIndexMSB);
+#endif
+    static uint8_t control_report[8];
+    const uint16_t interface = lValueLSBIndexMSB >> 16;
+    const uint16_t value = lValueLSBIndexMSB;
+    uint8_t size;
+    e->opaque = 0;
+    e->max_len = 0;
+    if (value != 0x0100 || reqLen < 0) return; /* Input, report ID 0 */
+    if (interface == 1) {
+        const uint8_t active = keyboard_active;
+        __asm__ __volatile__("" ::: "memory");
+        size = 8;
+        for (uint8_t i = 0; i < size; ++i)
+            control_report[i] = keyboard_report[active][i];
+    } else if (interface == 0) {
+        size = 4;
+        for (uint8_t i = 0; i < size; ++i)
+            control_report[i] = mouse_report[i];
+    } else {
+        return;
+    }
+    e->opaque = control_report;
+    e->max_len = (reqLen < size) ? reqLen : size;
+}
+
+#if UIAP_SNES_USB_TRACE
+/* Project-specific read-only vendor request, used only in the trace build.
+ * C1/5A, wValue=0, wIndex=1; reply: T, version, first key slot, IN toggle,
+ * IN-attempt count LE16, EP2 ACK count LE16. Counts wrap modulo 65536.
+ * This records a byte offered to usb_send_data, not the full packet or OS use.
+ */
+void usb_handle_other_control_message(struct usb_endpoint *e, struct usb_urb *s,
+                                       struct rv003usb_internal *ist)
+{
+    static uint8_t trace_reply[8];
+    if ((s->wRequestTypeLSBRequestMSB & 0x60) == 0x20)
+        trace_note_control(s->wRequestTypeLSBRequestMSB, s->lValueLSBIndexMSB);
+    if (s->wRequestTypeLSBRequestMSB != 0x5ac1) return;
+    if (s->lValueLSBIndexMSB == 0x00010001) {
+        static uint8_t history[136];
+        for (uint16_t i = 0; i < sizeof(history); ++i) history[i] = 0;
+        history[0] = 'H'; history[1] = 1;
+        history[2] = trace_control_count;
+        history[3] = trace_control_head;
+        for (uint8_t i = 0; i < trace_control_count; ++i) {
+            const uint8_t slot = (trace_control_head + 16u - trace_control_count + i) & 15u;
+            for (uint8_t j = 0; j < 8; ++j)
+                history[8u + 8u * i + j] = trace_controls[slot][j];
+        }
+        e->opaque = history;
+        e->max_len = (s->wLength < sizeof(history)) ? s->wLength : sizeof(history);
+        return;
+    }
+    if (s->lValueLSBIndexMSB != 0x00010000) return;
+    const uint16_t attempts = trace_in_count;
+    const uint16_t acknowledgements = ist->eps[2].count;
+    trace_reply[0] = 'T';
+    trace_reply[1] = 1;
+    trace_reply[2] = trace_first_key;
+    trace_reply[3] = ist->eps[2].toggle_in;
+    trace_reply[4] = attempts;
+    trace_reply[5] = attempts >> 8;
+    trace_reply[6] = acknowledgements;
+    trace_reply[7] = acknowledgements >> 8;
+    e->opaque = trace_reply;
+    e->max_len = (s->wLength < 8) ? s->wLength : 8;
+}
+#endif
+
+/* No keyboard LEDs are used. Preserve the existing ignored SET_REPORT behavior;
+ * rv003usb's separate bootloader feature handling is unchanged.
+ */
+void usb_handle_hid_set_report_start(struct usb_endpoint *e, int reqLen,
+                                      uint32_t lValueLSBIndexMSB)
+{
+    (void)e;
+    (void)reqLen;
+#if UIAP_SNES_USB_TRACE
+    trace_note_control(0x0921, lValueLSBIndexMSB);
+#else
+    (void)lValueLSBIndexMSB;
+#endif
+}
+#endif // !UIAP_WEBHID
