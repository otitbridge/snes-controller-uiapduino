+/* Diagnostic only: first key slot offered to EP2, and IN attempt count. */
+static volatile uint8_t trace_first_key;
+static volatile uint16_t trace_in_count;
+/* Last 16 HID class SETUP requests; no data payload or device identifiers. */
+static volatile uint8_t trace_controls[16][8];
+static volatile uint8_t trace_control_head, trace_control_count;
+static void trace_note_control(uint16_t request, uint32_t value_index)
+{
+    volatile uint8_t *entry = trace_controls[trace_control_head];
+    entry[0] = request;
+    entry[1] = request >> 8;
+    entry[2] = value_index;
+    entry[3] = value_index >> 8;
+    entry[4] = value_index >> 16;
+    entry[5] = value_index >> 24;
+    entry[6] = trace_in_count;
+    entry[7] = trace_in_count >> 8;
+    trace_control_head = (trace_control_head + 1u) & 15u;
+    if (trace_control_count < 16) ++trace_control_count;
+}
+#endif
 
